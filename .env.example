NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL. Neon (development and demo) or local PostgreSQL.
# For Neon, use sslmode=verify-full: plain "require" makes the pg driver print a warning.
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=verify-full&channel_binding=require
# DATABASE_URL=postgres://papertree:papertree@localhost:5432/papertree

# Admin panel address (allowed to call the API with cookies)
ADMIN_APP_URL=http://localhost:5173

# Set to 1 when running behind Cloudflare / nginx
TRUST_PROXY=0

# First Super Admin, created by `npm run db:seed`
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@papertree.com.bd
SEED_ADMIN_PASSWORD=change-me-please

# Interactive API docs at /docs (set false to hide them)
API_DOCS=true

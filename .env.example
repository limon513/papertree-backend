NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL. Neon (development and demo) or local PostgreSQL.
# For Neon, use sslmode=verify-full: plain "require" makes the pg driver print a warning.
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=verify-full&channel_binding=require
# DATABASE_URL=postgres://papertree:papertree@localhost:5432/papertree

# Admin panel address (allowed to call the API with cookies)
ADMIN_APP_URL=http://localhost:5173

# Set to 1 when running behind Cloudflare / nginx
TRUST_PROXY=0

# First Super Admin, created by `npm run db:seed`
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@papertree.com.bd
SEED_ADMIN_PASSWORD=change-me-please

# Interactive API docs at /docs (set false to hide them)
API_DOCS=true

# Uploaded images. "local" keeps them in uploads/ (only on this computer).
# "s3" uses S3-compatible storage: Neon Object Storage (demo), AWS S3 or similar (production).
STORAGE_DRIVER=local
# S3_ENDPOINT=https://br-xxxx.storage.c-4.ap-southeast-1.aws.neon.tech
# S3_REGION=ap-southeast-1
# S3_BUCKET=papertree
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Neon needs path-style URLs (endpoint/bucket/file). AWS works with both.
# S3_FORCE_PATH_STYLE=true
# Optional: public address of the files when a CDN or custom domain is in front.
# Empty = the bucket's own address (the bucket must allow public reads).
# MEDIA_PUBLIC_URL=

# Background jobs (product imports) run inside the API. Set false when separate
# worker processes run them instead (production: `npm run worker` under PM2).
JOB_WORKERS=true

# Master key for secrets saved in the admin (email/SMS API keys, payment passwords).
# 32 random bytes, base64. Use the SAME key on every server that shares the database.
# Make one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=
